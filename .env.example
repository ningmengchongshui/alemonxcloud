# HTTP server address. Use :8082 locally or 0.0.0.0:8082 in a container.
PORT=:8082

# debug, release, or test
GIN_MODE=debug

# OIDC client registered under the alemon organization in Auth.
# The redirect URI must exactly match the registered application callback URL.
PUBLIC_URL=http://localhost:8082
AUTH_OIDC_ISSUER=https://auth.alemonjs.com
AUTH_OIDC_CLIENT_ID=
# Leave empty for an Auth public client. Confidential clients set this server-side.
AUTH_OIDC_CLIENT_SECRET=
AUTH_OIDC_REDIRECT_URL=http://localhost:8082/callback

# Application permission that exposes the super-admin console.
AUTH_ADMIN_PERMISSION=cloud:admin

# Production persistence. Leave empty only for local development; otherwise
# instances survive xcloud-server restarts in MySQL.
MYSQL_DSN=xcloud:change-me@tcp(127.0.0.1:3306)/xcloud?charset=utf8mb4&parseTime=true&loc=Local
SESSION_REDIS_URL=redis://127.0.0.1:6379/0
RABBITMQ_URL=amqp://xcloud:change-me@127.0.0.1:5672/

# Bare-metal agent. Both values must be set together in production. The agent
# listens on localhost by default and must never be exposed through Nginx.
XCLOUD_AGENT_URL=http://127.0.0.1:9092
XCLOUD_AGENT_TOKEN=
XCLOUD_DOCKER_NETWORK=xcloud_network
XCLOUD_INSTANCE_DATA_ROOT=/var/lib/xcloud/instances
XCLOUD_INSTANCE_DOMAIN=alemonjs.com
