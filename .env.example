# xCloud control-plane configuration. Platform Agent, Tunnel Gateway and
# self-hosted Agent each use separate host-level configuration files.
# HTTP server address. Use :8082 locally or 0.0.0.0:8082 in a container.
PORT=:8082

# debug, release, or test
GIN_MODE=debug

# OIDC client registered under the alemon organization in Auth.
# The redirect URI must exactly match the registered application callback URL.
PUBLIC_URL=http://localhost:8082
AUTH_OIDC_ISSUER=https://auth.alemonjs.com
AUTH_OIDC_CLIENT_ID=
# Leave empty for an Auth public client. Confidential clients set this server-side.
AUTH_OIDC_CLIENT_SECRET=
AUTH_OIDC_REDIRECT_URL=http://localhost:8082/callback

# Application permission that exposes the super-admin console.
AUTH_ADMIN_PERMISSION=cloud:admin

# External production dependencies. Use addresses reachable from the
# xcloud-server container, not Docker Compose service names.
MYSQL_DSN=xcloud:change-me@tcp(mysql.example.internal:3306)/xcloud?charset=utf8mb4&parseTime=true&loc=Local
SESSION_REDIS_URL=redis://:change-me@redis.example.internal:6379/0
RABBITMQ_URL=amqp://xcloud:change-me@rabbitmq.example.internal:5672/

# Platform Agent addresses and tokens are registered only in the super-admin
# console. They are not global control-plane environment variables.
# Generate once with: openssl rand -base64 32. It encrypts per-node Agent
# tokens at rest and must not be rotated without a deliberate node re-key plan.
XCLOUD_NODE_TOKEN_ENCRYPTION_KEY=
XCLOUD_NODE_HEARTBEAT_TTL_SECONDS=90
XCLOUD_METRICS_TOKEN=
XCLOUD_DOCKER_NETWORK=xcloud_network
XCLOUD_INSTANCE_DATA_ROOT=/var/lib/xcloud/instances
XCLOUD_INSTANCE_DOMAIN=alemonjs.com
# Optional self-hosted node feature. The public URL is used only by
# xcloud-control's outbound WSS connection. The internal URL is used only by
# this control plane for Gateway /command, /terminal and /proxy requests.
# Its Nginx vhost must allow the control-plane network and deny public access.
XCLOUD_TUNNEL_URL=https://tunnel.alemonjs.com
# This is not a user enrollment token. Generate a long random value and use the
# same value as GATEWAY_COMMAND_TOKEN on every Gateway.
XCLOUD_TUNNEL_INTERNAL_URL=https://tunnel-internal.alemonjs.com
XCLOUD_TUNNEL_COMMAND_TOKEN=replace-with-a-long-random-secret
XCLOUD_COUPON_CODE_SECRET=
