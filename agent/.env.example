# Node-local configuration. Copy to agent/.env for make agent-run, or use
# /etc/xcloud-agent.env in production systemd deployments.
GIN_MODE=debug
AGENT_ADDR=0.0.0.0:13092
XCLOUD_AGENT_TOKEN=replace-with-a-node-specific-random-token
XCLOUD_DOCKER_NETWORK=xcloud_network
XCLOUD_INSTANCE_DATA_ROOT=./.xcloud/instances
