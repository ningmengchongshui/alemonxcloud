# One file per gateway. Both gateways share MySQL, Redis and the mTLS CA.
GATEWAY_ID=tunnel-a
GATEWAY_PUBLIC_LISTEN=:13072
GATEWAY_INTERNAL_LISTEN=:18443
GATEWAY_COMMAND_TOKEN=replace-with-the-same-long-random-secret-as-control-plane
GATEWAY_INTERNAL_URL=https://10.0.0.21:18443
MYSQL_DSN=xcloud:change-me@tcp(mysql.example.internal:3306)/xcloud?charset=utf8mb4&parseTime=true&loc=Local
SESSION_REDIS_URL=redis://:change-me@redis.example.internal:6379/0
GATEWAY_TLS_CERT=/etc/xcloud-tunnel/tls.crt
GATEWAY_TLS_KEY=/etc/xcloud-tunnel/tls.key
GATEWAY_TLS_CA=/etc/xcloud-tunnel/ca.crt
